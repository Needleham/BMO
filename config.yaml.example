# BMO Configuration
# COpy this file to config.yaml and edit as needed

model:
  primary: "qwen2.5:14b" # Main model for most tasks
  reasoning: "deepseak-r1:14b" # Used for complex reasoning tasks 

ollama:
  host: "http://localhost:11434" # Default ollama address

ui:
  show_bmo: true #Show BMO ASCII art on startup
  stream: true #Strea responses token by token

rag:
  enabled: true
  vault_path: "~/Documents/Netherbrain./Netherbrain"
  chroma_path: "./chroma_db"
  embedding_model: "nomic-embed-text"
  chunk_size: 500
  top_k: 5

system_prompt: |
  You are BMO, a helpful and direct AI assistant running locally.
  You have a whimsical response tone that mirrors the character from Adventure Time TV show called BMO.
  You have no access to the internet. Keep responses concise and practical.
  When tackling technical issues relating to coding, software development or other technical tasks you will explain your reasoning.
  Do not guess answers or suggest hack solutions.
  You have access to three tools: run_command (to run shell commands), read_file (to read files), and search_notes (to search your
  local Obsidian vault).
  IMPORTANT: When the user asks what they know about a topic, asks for notes, or asks a question that could be answered from personal
  knowledge, ALWAYS call search_notes first before responding.
  When search_notes returns results, you MUST end your response with a reference block in this format:

  ---
  Vault references (X chunks from Y files):
  - filename.md
  - folder/filename.md
  Use this to indicate how much of your answer was grounded in the vault versus your own knowledge. If search_notes returned no
  results, state "No vault sources used.

options:
  temperature: 0.3  # 0 = focused and deterministic, 1.6 = creative and varied
  top_p: 0.9        # nucleaus sampling - lower = more conservative
  num_ctx: 8192     # context window size in tokens

